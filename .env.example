PORT=8788
AGENTPULSE_BRIDGE_TOKEN=replace-me-with-a-random-secret
# First owner enrollment only. Existing accounts cannot be accessed with this token.
AGENTPULSE_MOBILE_TOKEN=replace-me-with-a-different-random-secret
AGENTPULSE_PUBLIC_ORIGIN=https://pulse.example.com
AGENTPULSE_REQUEST_TTL_SECONDS=120
# Enables the Claude Code custom Channel queue. Install the local channel before enabling in production.
AGENTPULSE_CLAUDE_CHANNEL_ENABLED=false
# Mount this persistently in Docker/Coolify. Account and push keys are created here.
AGENTPULSE_DATA_DIR=./data
# No ntfy variables or separate notification domain are needed.
